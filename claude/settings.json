{
  "cleanupPeriodDays": 365,
  "env": {
    "PATH": "/Users/tkay/.local/bin:/Users/tkay/.cargo/bin:/Applications/Visual Studio Code.app/Contents/Resources/app/bin:/Users/tkay/.krew/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/opt/homebrew/share/google-cloud-sdk/bin:/Users/tkay/go/bin:/Users/tkay/repos/atero-um/venv/bin:/Users/tkay/.gvm/pkgsets/go1.24.10/global/bin:/Users/tkay/.gvm/gos/go1.24.10/bin:/Users/tkay/.gvm/pkgsets/go1.24.10/global/overlay/bin:/Users/tkay/.gvm/bin:/usr/local/bin:/System/Cryptexes/App/usr/bin:/usr/bin:/bin:/usr/sbin:/sbin:/var/run/com.apple.security.cryptexd/codex.system/bootstrap/usr/local/bin:/var/run/com.apple.security.cryptexd/codex.system/bootstrap/usr/bin:/var/run/com.apple.security.cryptexd/codex.system/bootstrap/usr/appleinternal/bin:/opt/pmk/env/global/bin:/Applications/iTerm.app/Contents/Resources/utilities:/Users/tkay/.fzf/bin"
  },
  "permissions": {
    "allow": [
      "SandboxNetworkAccess",
      "Bash(.venv/bin/atero-grafana deploy:*)",
      "Bash(helm template:*)",
      "Bash(kubectl port-forward:*)",
      "Bash(atero-grafana --help)",
      "Bash(.venv/bin/atero-grafana targets:*)",
      "Read(//Users/tkay/repos/local-grafana/**)",
      "Bash(python3 -m json.tool)",
      "Skill(code-review)",
      "Skill(code-review:*)",
      "Bash(npx tsc *)",
      "Skill(deep-research)",
      "Skill(deep-research:*)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "Read(//Users/tkay/Downloads/**)",
      "Bash(helm dependency *)",
      "Bash(git -C ~/.claude add -u)",
      "Bash(git -C ~/.claude commit *)",
      "Bash(cp /Users/tkay/.cache/claude-handoff/* /Users/tkay/.claude/hooks/*)"
    ],
    "ask": [
      "Bash(python3 *board.py publish *)"
    ],
    "additionalDirectories": [
      "/tmp",
      "/Users/tkay/misc/values"
    ]
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|Edit|Write|NotebookEdit|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/tool-gate.py\" || exit 2",
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/lfg-state.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/lfg-state.py\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/lfg-state.py\""
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "SandboxNetworkAccess",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\": {\"hookEventName\": \"PermissionRequest\", \"decision\": {\"behavior\": \"allow\"}}}'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/question-shape.py\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "plumber-claude@crusoe-plumber": true,
    "wrenchmark@wrenchmark": true,
    "atero-skills@atero-skills": true
  },
  "extraKnownMarketplaces": {
    "crusoe-plumber": {
      "source": {
        "source": "directory",
        "path": "/Users/tkay/repos/plugin"
      }
    },
    "atero-skills": {
      "source": {
        "source": "git",
        "url": "https://gitlab.com/crusoeenergy/atero/atero-skills.git"
      },
      "autoUpdate": true
    },
    "wrenchmark": {
      "source": {
        "source": "git",
        "url": "https://gitlab.com/crusoeenergy/atero/wrenchmark.git"
      }
    }
  },
  "sandbox": {
    "filesystem": {
      "allowWrite": [
        "~/.config/gcloud",
        "~/repos",
        "/private/tmp"
      ],
      "allowRead": [
        "~/.config/gcloud"
      ]
    }
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "tui": "default",
  "autoMemoryEnabled": false,
  "skipWorkflowUsageWarning": true
}
